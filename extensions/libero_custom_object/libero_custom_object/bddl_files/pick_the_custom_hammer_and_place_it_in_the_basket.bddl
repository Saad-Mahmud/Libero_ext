(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the custom hammer and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (hammer_region
          (:target floor)
          (:ranges (
              (0.02 -0.28 0.38 0.08)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    custom_hammer_1 - custom_hammer
    basket_1 - basket
  )

  (:obj_of_interest
    custom_hammer_1
    basket_1
  )

  (:init
    (On custom_hammer_1 floor_hammer_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In custom_hammer_1 basket_1_contain_region))
  )

)
