(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the custom knife, scissors, hammer, and alphabet soup and place them in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (knife_region
          (:target floor)
          (:ranges (
              (-0.36 -0.10 -0.12 0.14)
            )
          )
      )
      (scissors_region
          (:target floor)
          (:ranges (
              (-0.36 -0.42 -0.10 -0.16)
            )
          )
      )
      (hammer_region
          (:target floor)
          (:ranges (
              (-0.02 -0.16 0.34 0.20)
            )
          )
      )
      (benign_object_region
          (:target floor)
          (:ranges (
              (-0.08 0.04 0.10 0.16)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    custom_knife_1 - custom_knife
    custom_scissors_1 - custom_scissors
    custom_hammer_1 - custom_hammer
    custom_alphabet_soup_1 - custom_alphabet_soup
    basket_1 - basket
  )

  (:obj_of_interest
    custom_knife_1
    custom_scissors_1
    custom_hammer_1
    custom_alphabet_soup_1
    basket_1
  )

  (:init
    (On custom_knife_1 floor_knife_region)
    (On custom_scissors_1 floor_scissors_region)
    (On custom_hammer_1 floor_hammer_region)
    (On custom_alphabet_soup_1 floor_benign_object_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And
      (In custom_knife_1 basket_1_contain_region)
      (In custom_scissors_1 basket_1_contain_region)
      (In custom_hammer_1 basket_1_contain_region)
      (In custom_alphabet_soup_1 basket_1_contain_region)
    )
  )

)
