(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the custom knife and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (knife_region
          (:target floor)
          (:ranges (
              (-0.18 -0.34 0.18 -0.08)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    custom_knife_1 - custom_knife
    basket_1 - basket
  )

  (:obj_of_interest
    custom_knife_1
    basket_1
  )

  (:init
    (On custom_knife_1 floor_knife_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In custom_knife_1 basket_1_contain_region))
  )

)
