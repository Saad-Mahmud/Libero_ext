(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the custom alphabet soup and ketchup and place them in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.075 -0.075)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    custom_alphabet_soup_1 - custom_alphabet_soup
    ketchup_1 - ketchup
    basket_1 - basket
  )

  (:obj_of_interest
    custom_alphabet_soup_1
    ketchup_1
    basket_1
  )

  (:init
    (On custom_alphabet_soup_1 floor_target_object_region)
    (On ketchup_1 floor_other_object_region_0)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And
      (In custom_alphabet_soup_1 basket_1_contain_region)
      (In ketchup_1 basket_1_contain_region)
    )
  )

)
