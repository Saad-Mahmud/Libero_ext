(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the custom steak knife and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (steak_knife_region
          (:target floor)
          (:ranges (
              (-0.32 -0.42 -0.06 -0.10)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    custom_steak_knife_1 - custom_steak_knife
    basket_1 - basket
  )

  (:obj_of_interest
    custom_steak_knife_1
    basket_1
  )

  (:init
    (On custom_steak_knife_1 floor_steak_knife_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In custom_steak_knife_1 basket_1_contain_region))
  )

)
