(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the custom scissors and hammer and place them in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (scissors_region
          (:target floor)
          (:ranges (
              (-0.32 -0.42 -0.08 -0.10)
            )
          )
      )
      (hammer_region
          (:target floor)
          (:ranges (
              (0.02 -0.28 0.38 0.08)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    custom_scissors_1 - custom_scissors
    custom_hammer_1 - custom_hammer
    basket_1 - basket
  )

  (:obj_of_interest
    custom_scissors_1
    custom_hammer_1
    basket_1
  )

  (:init
    (On custom_scissors_1 floor_scissors_region)
    (On custom_hammer_1 floor_hammer_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And
      (In custom_scissors_1 basket_1_contain_region)
      (In custom_hammer_1 basket_1_contain_region)
    )
  )

)
